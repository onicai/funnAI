type http_request_result = 
 record {
   body: blob;
   headers: vec http_header;
   status: nat;
 };
type http_header = 
 record {
   name: text;
   value: text;
 };
type UpdateDailyMetricAdminInput = 
 record {
   date: text;
   input: DailyMetricUpdateInput;
 };
type TotalCycles = 
 record {
   all: CycleAmount;
   mainers: CycleAmount;
   protocol: CycleAmount;
 };
type TotalBurnedResult = 
 variant {
   Err: ApiError;
   Ok: TotalBurnedRecord;
 };
type TotalBurnedRecord = 
 record {
   lastScanTimestampNs: nat64;
   lastScannedBlock: nat;
   totalBurnedE8s: nat;
 };
type TokenRewardsMetadata = 
 record {
   dataset: text;
   description: text;
   last_updated: text;
   units: record {
            rewards_per_challenge: text;
            total_minted: text;
          };
   version: text;
 };
type TokenRewardsEntry = 
 record {
   date: text;
   notes: text;
   quarter: text;
   rewards_per_challenge: float64;
   rewards_per_quarter: float64;
   total_minted: float64;
 };
type TokenRewardsDataResult = 
 variant {
   Err: ApiError;
   Ok: TokenRewardsData;
 };
type TokenRewardsData = 
 record {
   data: vec TokenRewardsEntry;
   metadata: TokenRewardsMetadata;
 };
type TimeInterval = variant {Daily;};
type TextResult = 
 variant {
   Err: ApiError;
   Ok: text;
 };
type SystemMetrics = 
 record {
   daily_burn_rate: DailyBurnRate;
   funnai_index: float64;
   total_cycles: opt TotalCycles;
 };
type StatusCodeRecordResult = 
 variant {
   Err: ApiError;
   Ok: StatusCodeRecord;
 };
type StatusCodeRecord = record {status_code: StatusCode;};
type StatusCode = nat16;
type ShareAgentRegistryWithActivityResult = 
 variant {
   Err: ApiError;
   Ok: ShareAgentRegistryWithActivity;
 };
type ShareAgentRegistryWithActivity = 
 record {
   activity: vec ShareAgentActivity;
   registry: vec OfficialMainerAgentCanister;
 };
type ShareAgentActivity = 
 record {
   address: text;
   cycleBalance: nat;
   cyclesBurnRate: CyclesBurnRateDefault;
   lastChallengeRequestTimestamp: nat64;
 };
type SelectableMainerLLMs = variant {Qwen2_5_500M;};
type RewardType = 
 variant {
   Coupon: text;
   Cycles;
   ICP;
   MainerToken;
   Other: text;
 };
type Result = 
 variant {
   Err: ApiError;
   Ok: DailyMetricsRunStatus;
 };
type ProtocolCanisterType = 
 variant {
   Challenger;
   Judge;
   MainerAgent: MainerAgentCanisterType;
   MainerCreator;
   MainerLlm;
   Verifier;
 };
type PricingCacheResult = 
 variant {
   Err: ApiError;
   Ok: PricingCache;
 };
type PricingCache = 
 record {
   icApiTcycleBurnRatePerDay: float64;
   lastUpdatedNs: nat64;
   usdPerComputedXdr: float64;
   xdrPermyriadPerIcp: nat64;
 };
type PeriodInfo = 
 record {
   end_date: text;
   start_date: text;
   total_days: nat;
 };
type OfficialMainerAgentCanister = 
 record {
   address: CanisterAddress;
   canisterType: ProtocolCanisterType;
   createdBy: principal;
   creationTimestamp: nat64;
   mainerConfig: MainerConfigurationInput;
   ownedBy: principal;
   status: CanisterStatus;
   subnet: text;
 };
type NatResult = 
 variant {
   Err: ApiError;
   Ok: nat;
 };
type MainersTierBreakdown = 
 record {
   custom: nat;
   high: nat;
   low: nat;
   medium: nat;
   very_high: nat;
 };
type MainersMetrics = 
 record {
   breakdown_by_tier:
    record {
      active: MainersTierBreakdown;
      paused: MainersTierBreakdown;
    };
   totals: record {
             active: nat;
             created: nat;
             paused: nat;
             total_cycles: nat;
           };
 };
type MainerConfigurationInput = 
 record {
   cyclesForMainer: nat;
   mainerAgentCanisterType: MainerAgentCanisterType;
   selectedLLM: opt SelectableMainerLLMs;
   subnetCtrl: text;
   subnetLlm: text;
 };
type MainerAgentCanisterType = 
 variant {
   NA;
   Own;
   ShareAgent;
   ShareService;
 };
type LlmSetupStatus = 
 variant {
   CanisterCreated;
   CanisterCreationInProgress;
   CodeInstallInProgress;
   ConfigurationInProgress;
   ModelUploadProgress: nat8;
 };
type DerivedMetrics = 
 record {
   active_percentage: float64;
   avg_cycles_per_mainer: float64;
   burn_rate_per_active_mainer: float64;
   paused_percentage: float64;
   tier_distribution:
    record {
      custom: float64;
      high: float64;
      low: float64;
      medium: float64;
      very_high: float64;
    };
 };
type DailyMetricsRunStatus = 
 record {
   lastFailureMessage: opt text;
   lastSuccessfulMetricDate: opt text;
   timerActive: bool;
 };
type DailyMetricsResult = 
 variant {
   Err: ApiError;
   Ok: DailyMetricsResponse;
 };
type DailyMetricsResponse = 
 record {
   daily_metrics: vec DailyMetric;
   period: PeriodInfo;
 };
type DailyMetricsQuery = 
 record {
   end_date: opt text;
   limit: opt nat;
   start_date: opt text;
 };
type DailyMetricUpdateInput = 
 record {
   active_custom_burn_rate_mainers: opt nat;
   active_high_burn_rate_mainers: opt nat;
   active_low_burn_rate_mainers: opt nat;
   active_medium_burn_rate_mainers: opt nat;
   active_very_high_burn_rate_mainers: opt nat;
   daily_burn_rate_cycles: opt nat;
   daily_burn_rate_usd: opt float64;
   funnai_index: opt float64;
   paused_custom_burn_rate_mainers: opt nat;
   paused_high_burn_rate_mainers: opt nat;
   paused_low_burn_rate_mainers: opt nat;
   paused_medium_burn_rate_mainers: opt nat;
   paused_very_high_burn_rate_mainers: opt nat;
   total_active_mainers: opt nat;
   total_cycles_all: opt nat;
   total_cycles_all_mainers: opt nat;
   total_cycles_all_usd: opt float64;
   total_cycles_mainers_usd: opt float64;
   total_cycles_protocol: opt nat;
   total_cycles_protocol_usd: opt float64;
   total_mainers_created: opt nat;
   total_paused_mainers: opt nat;
 };
type DailyMetricResult = 
 variant {
   Err: ApiError;
   Ok: DailyMetric;
 };
type DailyMetricMetadata = 
 record {
   created_at: text;
   date: text;
   updated_at: text;
 };
type DailyMetricInput = 
 record {
   active_custom_burn_rate_mainers: nat;
   active_high_burn_rate_mainers: nat;
   active_low_burn_rate_mainers: nat;
   active_medium_burn_rate_mainers: nat;
   active_very_high_burn_rate_mainers: nat;
   daily_burn_rate_cycles: nat;
   daily_burn_rate_usd: float64;
   date: text;
   funnai_index: float64;
   paused_custom_burn_rate_mainers: nat;
   paused_high_burn_rate_mainers: nat;
   paused_low_burn_rate_mainers: nat;
   paused_medium_burn_rate_mainers: nat;
   paused_very_high_burn_rate_mainers: nat;
   total_active_mainers: nat;
   total_cycles_all: opt nat;
   total_cycles_all_mainers: nat;
   total_cycles_all_usd: opt float64;
   total_cycles_mainers_usd: opt float64;
   total_cycles_protocol: opt nat;
   total_cycles_protocol_usd: opt float64;
   total_mainers_created: nat;
   total_paused_mainers: nat;
 };
type DailyMetric = 
 record {
   derived_metrics: DerivedMetrics;
   mainers: MainersMetrics;
   metadata: DailyMetricMetadata;
   system_metrics: SystemMetrics;
 };
type DailyBurnRate = 
 record {
   cycles: nat;
   usd: float64;
 };
type CyclesBurnRateDefault = 
 variant {
   Custom: CyclesBurnRate;
   High;
   Low;
   Mid;
   VeryHigh;
 };
type CyclesBurnRate = 
 record {
   cycles: nat;
   timeInterval: TimeInterval;
 };
type CycleAmount = 
 record {
   cycles: nat;
   usd: float64;
 };
type ChallengesResult = 
 variant {
   Err: ApiError;
   Ok: vec Challenge;
 };
type ChallengeWinnerReward = 
 record {
   amount: nat;
   distributed: bool;
   distributedTimestamp: opt nat64;
   rewardDetails: text;
   rewardType: RewardType;
 };
type ChallengeWinnerDeclarationArray = 
 record {
   challengeId: text;
   finalizedTimestamp: nat64;
   participants: vec ChallengeParticipantEntry;
   secondPlace: ChallengeParticipantEntry;
   thirdPlace: ChallengeParticipantEntry;
   winner: ChallengeParticipantEntry;
 };
type ChallengeTopicStatus = 
 variant {
   Archived;
   Closed;
   Open;
   Other: text;
 };
type ChallengeStatus = 
 variant {
   Archived;
   Closed;
   Open;
   Other: text;
 };
type ChallengeParticipationResult = 
 variant {
   Other: text;
   Participated;
   SecondPlace;
   ThirdPlace;
   Winner;
 };
type ChallengeParticipantEntry = 
 record {
   ownedBy: principal;
   result: ChallengeParticipationResult;
   reward: ChallengeWinnerReward;
   submissionId: text;
   submittedBy: principal;
 };
type Challenge = 
 record {
   challengeClosedTimestamp: opt nat64;
   challengeCreatedBy: CanisterAddress;
   challengeCreationTimestamp: nat64;
   challengeId: text;
   challengeQuestion: text;
   challengeQuestionSeed: nat32;
   challengeStatus: ChallengeStatus;
   challengeTopic: text;
   challengeTopicCreationTimestamp: nat64;
   challengeTopicId: text;
   challengeTopicStatus: ChallengeTopicStatus;
   cyclesGenerateChallengeChctrlChllm: nat;
   cyclesGenerateChallengeGsChctrl: nat;
   cyclesGenerateResponseOwnctrlGs: nat;
   cyclesGenerateResponseOwnctrlOwnllmHIGH: nat;
   cyclesGenerateResponseOwnctrlOwnllmLOW: nat;
   cyclesGenerateResponseOwnctrlOwnllmMEDIUM: nat;
   cyclesGenerateResponseSactrlSsctrl: nat;
   cyclesGenerateResponseSsctrlGs: nat;
   cyclesGenerateResponseSsctrlSsllm: nat;
   cyclesSubmitResponse: nat;
   judgePromptId: text;
   mainerMaxContinueLoopCount: nat;
   mainerNumTokens: nat64;
   mainerPromptId: text;
   mainerTemp: float64;
   protocolOperationFeesCut: nat;
 };
type CanisterStatus = 
 variant {
   ControllerCreated;
   ControllerCreationInProgress;
   LlmSetupFinished;
   LlmSetupInProgress: LlmSetupStatus;
   Other: text;
   Paid;
   Paused;
   Running;
   Unlocked;
 };
type CanisterAddress = text;
type CacheStatusResult = 
 variant {
   Err: ApiError;
   Ok: CacheStatus;
 };
type CacheStatus = 
 record {
   cachedChallengesCount: nat;
   cachedWinnersCount: nat;
   lastSyncTimestamp: nat64;
   syncIntervalSeconds: nat;
 };
type AuthRecordResult = 
 variant {
   Err: ApiError;
   Ok: AuthRecord;
 };
type AuthRecord = record {auth: text;};
type AssignAdminRoleInputRecord = 
 record {
   note: text;
   "principal": text;
   role: AdminRole;
 };
type ApiError = 
 variant {
   FailedOperation;
   InsuffientCycles: nat;
   InvalidId;
   Other: text;
   StatusCode: StatusCode;
   Unauthorized;
   ZeroAddress;
 };
type ApiCanister = 
 service {
   amiController: () -> (AuthRecordResult) query;
   assignAdminRole: (input: AssignAdminRoleInputRecord) ->
    (AdminRoleAssignmentResult);
   bulkCreateDailyMetricsAdmin: (inputs: vec DailyMetricInput) -> (NatResult);
   createDailyMetricAdmin: (input: DailyMetricInput) -> (DailyMetricResult);
   deleteDailyMetricAdmin: (date: text) -> (NatResult);
   /// Get recent protocol activity with independent pagination
   getActivityFeed: (input: ActivityFeedQuery) -> (ActivityFeedResult) query;
   /// Get cache status for monitoring
   getActivityFeedCacheStatus: () -> (CacheStatusResult) query;
   getActivityFeedSyncIntervalAdmin: () -> (NatResult) query;
   getAdminRoles: () -> (AdminRoleAssignmentsResult) query;
   getDailyMetricByDate: (date: text) -> (DailyMetricResult) query;
   getDailyMetrics: (dailyMetricsQuery: opt DailyMetricsQuery) ->
    (DailyMetricsResult) query;
   getDailyMetricsAdmin: () -> (DailyMetricsResult) query;
   getDailyMetricsRunStatusAdmin: () -> (Result) query;
   getLatestDailyMetric: () -> (DailyMetricResult) query;
   getMasterCanisterId: () -> (AuthRecordResult) query;
   getNumDailyMetrics: () -> (NatResult) query;
   /// Get current open challenges from cache
   getOpenChallengesFromCache: () -> (ChallengesResult) query;
   getPricingCacheAdmin: () -> (PricingCacheResult) query;
   getShareServiceCanisterIdAdmin: () -> (AuthRecordResult) query;
   getTokenIndexCanisterIdAdmin: () -> (AuthRecordResult) query;
   getTokenRewardsData: () -> (TokenRewardsDataResult) query;
   getTotalBurned: () -> (TotalBurnedResult) query;
   health: () -> (StatusCodeRecordResult) query;
   previewDailyMetricsAggregationAdmin: () -> (DailyMetricResult);
   previewIsoDateAdmin: (nanos: int) -> (TextResult) query;
   pricingTransform: (args:
    record {
      context: blob;
      response: http_request_result;
    }) -> (http_request_result) query;
   pullShareServiceSnapshotAdmin: () ->
    (ShareAgentRegistryWithActivityResult);
   resetDailyMetricsAdmin: () -> (NatResult);
   revokeAdminRole: ("principal": text) -> (TextResult);
   setActivityFeedSyncIntervalAdmin: (_syncIntervalInSeconds: nat) ->
    (StatusCodeRecordResult);
   setMasterCanisterId: (newMasterCanisterId: text) -> (AuthRecordResult);
   setShareServiceCanisterIdAdmin: (newShareServiceCanisterId: text) ->
    (AuthRecordResult);
   setTokenIndexCanisterIdAdmin: (newTokenIndexCanisterId: text) ->
    (AuthRecordResult);
   startActivityFeedTimerAdmin: () -> (AuthRecordResult);
   startBurnScanTimerAdmin: () -> (AuthRecordResult);
   startDailyMetricsTimerAdmin: () -> (AuthRecordResult);
   startPricingTimerAdmin: () -> (AuthRecordResult);
   stopActivityFeedTimerAdmin: () -> (AuthRecordResult);
   stopBurnScanTimerAdmin: () -> (AuthRecordResult);
   stopDailyMetricsTimerAdmin: () -> (AuthRecordResult);
   stopPricingTimerAdmin: () -> (AuthRecordResult);
   triggerBurnScanAdmin: () -> (AuthRecordResult);
   triggerDailyMetricsAggregationAdmin: () -> (DailyMetricResult);
   updateDailyMetricAdmin: (params: UpdateDailyMetricAdminInput) ->
    (DailyMetricResult);
   whoami: () -> (principal) query;
 };
type AdminRoleAssignmentsResult = 
 variant {
   Err: ApiError;
   Ok: vec AdminRoleAssignment;
 };
type AdminRoleAssignmentResult = 
 variant {
   Err: ApiError;
   Ok: AdminRoleAssignment;
 };
type AdminRoleAssignment = 
 record {
   assignedAt: nat64;
   assignedBy: text;
   note: text;
   "principal": text;
   role: AdminRole;
 };
type AdminRole = 
 variant {
   AdminQuery;
   AdminUpdate;
 };
type ActivityFeedResult = 
 variant {
   Err: ApiError;
   Ok: ActivityFeedResponse;
 };
type ActivityFeedResponse = 
 record {
   cacheTimestamp: nat64;
   challenges: vec Challenge;
   totalChallenges: nat;
   totalWinners: nat;
   winners: vec ChallengeWinnerDeclarationArray;
 };
type ActivityFeedQuery = 
 record {
   challengesLimit: opt nat;
   challengesOffset: opt nat;
   sinceTimestamp: opt nat64;
   winnersLimit: opt nat;
   winnersOffset: opt nat;
 };
service : () -> ApiCanister
